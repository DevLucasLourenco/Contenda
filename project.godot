[layer_names]

; Espelhado em src/Core/GameConstants.cs — PhysicsLayers. Os dois lados andam
; juntos, e um teste em Contenda.Tests reprova a divergência.
; Ver docs/specs/01-arquitetura-tecnica.md §8.
3d_physics/layer_1="World"
3d_physics/layer_2="PlayerBody"
3d_physics/layer_3="EnemyBody"
3d_physics/layer_4="PlayerHitbox"
3d_physics/layer_5="EnemyHitbox"
3d_physics/layer_6="PlayerHurtbox"
3d_physics/layer_7="EnemyHurtbox"
3d_physics/layer_8="Projectile"
3d_physics/layer_9="GroundPlane"
3d_physics/layer_10="Interactable"

[navigation]

; Precisa bater com cell_size/cell_height da navmesh em data/navmesh/.
; Divergir faz o servidor avisar e degrada a precisão do caminho.
3d/default_cell_size=0.2
3d/default_cell_height=0.2

[rendering]

; Explícito de propósito: o editor omite por ser o padrão atual, mas a
; spec 01 §1 fixa Forward+ e um padrão implícito muda sem aviso.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
