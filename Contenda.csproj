<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <RootNamespace>Contenda</RootNamespace>
    <AssemblyName>Contenda</AssemblyName>
    <Version>0.1.0</Version>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Religado no ticket 03, junto com o .editorconfig na raiz. Os dois são
         inseparáveis: um sem o outro é armadilha. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005 (using desnecessário) só roda no build com o XML de documentação
         ligado — é uma exigência do compilador, não escolha nossa.
         Ligá-lo, porém, faz o CS1591 cobrar <summary> em todo membro público, o
         que viraria centenas de erros e mataria o valor do TreatWarningsAsErrors.
         Documentamos por julgamento (convenções §8), não por obrigação. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    O Godot.NET.Sdk inclui **/*.cs por padrão. Os projetos abaixo compilam
    separado e precisam ficar de fora, senão o assembly do jogo tenta
    compilar os testes (ticket 03).
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>

</Project>
