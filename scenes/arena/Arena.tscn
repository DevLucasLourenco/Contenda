; Rampas construídas como micro-degraus de 1 m de corrida por 0,125 m de
; subida (8 degraus = 8 m de corrida para 1 m, ~7°): uma única caixa
; inclinada não bakeia como superfície conectada no navmesh do Godot/recast
; em cell_size=0,2 (confirmado isoladamente em scenes/debug/RampTest.tscn --
; o bake produzia só uma lasca desconectada e MapGetPath nunca atravessava).
; Degraus baixos e planos são a técnica que o recast realmente conecta, e um
; riser de 12,5 cm continua indistinguível de uma rampa lisa para o jogador
; e para o inimigo -- "rampas, não degraus" na spec é sobre não travar
; ninguém numa quina visível, não sobre lisura matemática literal.

[sub_resource type="BoxMesh" id="Mesh_degrau_ns"]
material = SubResource("Mat_rampa")
size = Vector3(6, 0.5, 1)

[sub_resource type="BoxShape3D" id="Shape_degrau_ns"]
size = Vector3(6, 0.5, 1)

[sub_resource type="BoxMesh" id="Mesh_degrau_lo"]
material = SubResource("Mat_rampa")
size = Vector3(1, 0.5, 6)

[sub_resource type="BoxShape3D" id="Shape_degrau_lo"]
size = Vector3(1, 0.5, 6)

